{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{pramaan/**,rulepacks/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|widget/|host-a|host-b|samples/|assets/).*)", "destination": "/index.html" }
  ],
  "regions": ["bom1"]
}
